#!/usr/bin/env python
# -*- coding: utf-8 -*-
# 人民日报电子版 + 半月谈 · 全文 RSS 推送
# 数据源：RSSHub（rsshub.ktachibana.party，实测全文输出路由）
# 说明：use_embedded_content=True 直接使用 feed 内嵌全文，无需二次抓取原站
# 自定义源：workflow 注入环境变量 FEEDS_CONFIG（JSON 数组 [{"title","url"}]，
#          由网页控制台维护 vars.FEEDS）；缺失/损坏时回退下方默认源

import json
import os

from calibre.web.feeds.news import BasicNewsRecipe

DEFAULT_FEEDS = [
    (u'人民日报电子版', 'https://rsshub.ktachibana.party/people/paper'),
    (u'半月谈·今日谈', 'https://rsshub.ktachibana.party/banyuetan/jinritan'),
    (u'半月谈·时政讲解', 'https://rsshub.ktachibana.party/banyuetan/shizhengjiangjie'),
    (u'半月谈·评论', 'https://rsshub.ktachibana.party/banyuetan/banyuetanpinglun'),
    (u'半月谈·基层治理', 'https://rsshub.ktachibana.party/banyuetan/jicengzhili'),
    (u'半月谈·文化', 'https://rsshub.ktachibana.party/banyuetan/wenhua'),
    (u'半月谈·教育', 'https://rsshub.ktachibana.party/banyuetan/jiaoyu'),
]


def load_feeds():
    """读取网页控制台配置的自定义源；未设置或格式损坏时回退默认源。"""
    raw = os.environ.get('FEEDS_CONFIG') or os.environ.get('feeds_config') or ''
    if raw.strip():
        try:
            items = json.loads(raw)
            feeds = []
            for it in items:
                if not isinstance(it, dict):
                    continue
                t = str(it.get('title') or '').strip()
                u = str(it.get('url') or '').strip()
                if t and u:
                    feeds.append((t, u))
            if feeds:
                return feeds
        except Exception:
            pass
    return DEFAULT_FEEDS


class RenminBanyuetan(BasicNewsRecipe):
    title = u'人民日报与半月谈'
    description = u'人民日报电子版与半月谈（今日谈/时政讲解/评论/基层治理/文化/教育）每日全文合集'
    __author__ = 'chen113323'
    language = 'zh_CN'
    encoding = 'utf-8'

    oldest_article = 1          # 只收最近 1 天（默认 7 天）：固定 08:00 运行时恰好覆盖昨日傍晚新发文章，每篇只推一次
    max_articles_per_feed = 40
    use_embedded_content = True  # RSSHub 路由为全文输出型，直接复用内嵌正文
    auto_cleanup = True          # 若个别条目无内嵌内容，回退到原站抓取并做正文提取
    no_stylesheets = True
    remove_javascript = True

    def __init__(self, *args, **kwargs):
        BasicNewsRecipe.__init__(self, *args, **kwargs)
        # 书名自定义：网页控制台维护 vars.BOOK_TITLE → workflow 注入环境变量；未设置则用默认
        t = os.environ.get('BOOK_TITLE') or os.environ.get('book_title') or ''
        if t.strip():
            self.title = t.strip()

    def get_feeds(self):
        """动态 feed 列表：优先网页控制台配置的自定义源（vars.FEEDS），回退默认。"""
        return load_feeds()

    # 分区目录内容页：标题字号降为接近正文（rescale 120→90）+ 删除标题后的日期
    # 机制：flatcss 转换读取 data-calibre-rescale 计算最终 font-size（内联 font-size 会被其覆盖，勿用）
    def postprocess_book(self, oeb, opts, log):
        for item in oeb.spine:
            root = item.data
            if root is None:
                continue
            for li in root.xpath('//*[local-name()="li" and starts-with(@id,"article_")]'):
                for a in li.xpath('.//*[local-name()="a" and contains(@class,"article")]'):
                    a.set('data-calibre-rescale', '90')
                for sp in li.xpath('.//*[local-name()="span" and contains(@class,"article_date")]'):
                    sp.getparent().remove(sp)

    # 索引页与 Kindle 目录只显示纯标题（点击标题跳转正文），不显示摘要小字
    def description_limiter(self, src):
        return u''
